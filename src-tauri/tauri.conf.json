{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yali",
  "version": "0.3.0-alpha",
  "identifier": "app.yali",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Yali",
        "visible": false,
        "incognito": true,
        "width": 980,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "fileAssociations": [
      {
        "ext": ["png"],
        "name": "PNG 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/png",
        "contentTypes": ["public.png"]
      },
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/jpeg",
        "contentTypes": ["public.jpeg"]
      },
      {
        "ext": ["heic"],
        "name": "HEIC 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/heic",
        "contentTypes": ["public.heic"]
      },
      {
        "ext": ["heif"],
        "name": "HEIF 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/heif",
        "contentTypes": ["public.heif"]
      },
      {
        "ext": ["gif"],
        "name": "GIF 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/gif",
        "contentTypes": ["com.compuserve.gif"]
      },
      {
        "ext": ["webp"],
        "name": "WebP 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/webp",
        "contentTypes": ["org.webmproject.webp"]
      },
      {
        "ext": ["avif"],
        "name": "AVIF 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/avif",
        "contentTypes": ["public.avif"]
      },
      {
        "ext": ["jxl"],
        "name": "JPEG XL 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/jxl",
        "contentTypes": ["public.jpeg-xl"]
      },
      {
        "ext": ["tif", "tiff"],
        "name": "TIFF 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/tiff",
        "contentTypes": ["public.tiff"]
      },
      {
        "ext": ["bmp"],
        "name": "BMP 图片",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/bmp",
        "contentTypes": ["com.microsoft.bmp"]
      }
    ]
  }
}
